#cloud-config
# NoCloud seed for ROC-RK3399-PC (Ubuntu 26.04.1 LTS).
# Installs offline wpasupplicant + avahi-daemon from CIDATA /debs before online boot,
# because generic Ubuntu Server arm64 omits wpasupplicant by default.

preserve_hostname: true

users:
  - default
  - name: ubuntu
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM2VhzI0h99j4UsZYjkhGIcUmgLhuOZGUEEc7SPD5N2g mac-host

ssh_pwauth: false

write_files:
  - path: /etc/default/grub.d/99-headless.cfg
    content: |
      GRUB_TIMEOUT=2
      GRUB_RECORDFAIL_TIMEOUT=2

runcmd:
  - |
    set -e
    mkdir -p /mnt/cidata
    DEV=$(blkid -L CIDATA || true)
    if [ -n "$DEV" ]; then
      mount -o ro "$DEV" /mnt/cidata 2>/dev/null || true
    fi
    for d in /mnt/cidata/debs /run/cloud-init/tmp/*/debs; do
      if [ -d "$d" ] && ls "$d"/*.deb >/dev/null 2>&1; then
        dpkg -i "$d"/*.deb || true
        break
      fi
    done
    umount /mnt/cidata 2>/dev/null || true
  - [ rfkill, unblock, wifi ]
  - [ netplan, generate ]
  - [ netplan, apply ]
  - [ systemctl, enable, --now, avahi-daemon ]
  - [ rm, -f, /etc/ssh/ssh_host_* ]
  - [ dpkg-reconfigure, -f, noninteractive, openssh-server ]
  - [ update-grub ]

power_state:
  mode: reboot
  delay: now
  message: "Provisioning complete, restarting"
  timeout: 30
  condition: true
