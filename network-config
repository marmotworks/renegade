version: 2
ethernets:
  # Gigabit Ethernet. Optional so boot never blocks on an unplugged cable.
  eth0:
    match:
      name: eth0
    dhcp4: true
    optional: true

  # The gadget interface, created by usb-gadget.service before networkd configures it.
  # The static address makes the board reachable the moment the cable is plugged in;
  # DHCP is also on because macOS Internet Sharing runs its own DHCP server on that
  # link and is what provides the board's only default route and DNS.
  usb0:
    match:
      name: usb0
    addresses:
      - 10.55.0.1/24
    dhcp4: true
    dhcp4-overrides:
      route-metric: 100
    optional: true
